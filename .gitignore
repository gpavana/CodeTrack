# CodeTrack Global .gitignore

# Dependencies
node_modules/
backend/target/
frontend/node_modules/
frontend/dist/

# Environment Variables & Secrets
.env
*.env.local
backend/.env
frontend/.env

# IDE and Editor Files
.idea/
.vscode/
*.iml
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# Logs and Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.system_generated/

# OS Generated
.DS_Store
Thumbs.db

# Additional environment files
!.env.example
.env.*
backend/.env.*
frontend/.env.*

# Java compiled files
*.class

# Build output
dist/
target/